# ตัวอย่างไฟล์ .dev.vars — ก๊อปเป็น `.dev.vars` แล้วค่อยเติมค่าจริง (ไฟล์ .dev.vars ห้าม commit)
# ค่าในไฟล์ตัวอย่างนี้ต้องว่างเสมอ — ห้ามใส่ key จริงเด็ดขาด

# engine ที่ใช้อ่านรูป: mock (ค่าเริ่มต้น ไม่ต้องมี key) / qwen / vision / typhoon
OCR_PROVIDER=mock

# คีย์ของ OCR engine จริง — ยังไม่เคาะว่าใช้เจ้าไหน ปล่อยว่างไว้ก่อน
# [ยังไม่ได้ใช้] รอ implement engine จริง (gemini/qwen/vision/typhoon ยังเป็น stub)
OCR_API_KEY=

# จากหน้า LINE Developers Console (Messaging API channel ของ "บอทรับรูปจากคนขับ")
# ไม่ตั้ง = worker เข้าโหมด mock (ตอบ 200 พร้อมธง mock ไม่ตรวจลายเซ็น)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# โทเคนกันคนนอกอ่าน/แก้ผล OCR ผ่าน /api/ocr/* — ก่อนใช้จริงต้องตั้งเสมอ (ว่าง = โหมดทดลอง ไม่ตรวจ)
PULL_TOKEN=

# โดเมนเว็บ jobslip ที่อนุญาตให้ดึงผล OCR ข้ามโดเมนได้ (CORS) — ไม่ตั้ง = ไม่ปล่อย CORS เลย
# ของจริงใส่: https://ohmkanatip.github.io
ALLOW_ORIGIN=

# ── หมายเหตุ: D1 ไม่ได้ตั้งที่นี่ ──
# เป็น "binding" ตั้งใน wrangler.jsonc: binding "DB" → ตาราง ocr_results (env.DB)
# ไม่มี env.DB = ใช้ตารางในหน่วยความจำแทน (หายเมื่อ Worker รีสตาร์ท — พอสำหรับ dev เท่านั้น)
